// plasma.dlss — NVIDIA DLSS Super Resolution for the engine's upscaler framework.
//
// The AUTHORED manifest, kept in source next to the plugin. Component hashes and sizes are NOT
// here: the packaging step computes those and emits them into the published manifest.
//
// Field reference and validation rules: Docs/PluginPackageManagerPlan.html §05.

PackageInfo
{
	string %Id{"plasma.dlss"}
	string %Version{"1.0.0"}
	string %Publisher{"PlasmaTechnology"}
	string %License{"MIT"}
	string %Homepage{"https://plasmagameengine.com"}

	string %MinEngineVersion{"0.12.1"}
	string %MaxEngineVersion{""}
	string %AbiTag{"win64-msvc19-0.12.1-abi7-dev"}

	string %DisplayName{"NVIDIA DLSS"}
	string %Category{"Rendering"}
	string %Description{"Adds NVIDIA DLSS Super Resolution as a temporal upscaler (Rendering.Upscaler = DLSS) on D3D12 with NVIDIA RTX GPUs. Vulkan is not supported yet. Ships no NVIDIA runtime: NVIDIA's licence does not allow redistributing it outside an application. A build of the package from source gets the SDK through its git submodule; ship nvngx_dlss.dll from the DLSS SDK next to your game executable. Can be installed alongside the other upscaler packages; the game settings choose between them."}
	string %Icon{"Branding/DLSSIcon.png"}
	string %Banner{"Branding/DLSSBanner.png"}

	string %EditorPlugins{}
	string %EditorEnginePlugins{}
	string %RuntimePlugins{"plDLSSPlugin"}
	string %PackageDependencies{}

	Component { string %Name{"manifest"} string %Platform{"any"} }
	Component { string %Name{"runtime-win64"} string %Platform{"win64"} }
	Component { string %Name{"icon"} string %Platform{"any"} }
	Component { string %Name{"banner"} string %Platform{"any"} }
}
